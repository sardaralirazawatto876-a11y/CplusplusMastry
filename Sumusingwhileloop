#include <iostream>
using namespace std;

int main()
{
    int i = 1;
    int limit;
    int sum = 0;

    cout << "Enter your limit: ";
    cin >> limit;

    while (i <= limit)
    {
        sum = sum + i;
        i++;
    }

    cout << "Total sum = " << sum;

    return 0;
}